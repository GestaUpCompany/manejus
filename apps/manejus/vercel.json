{
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ../../packages ../../pnpm-lock.yaml ../../pnpm-workspace.yaml || exit 1",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/pdf/*.js": {
      "includeFiles": "{node_modules/{chart.js/dist/chart.umd.min.js,maplibre-gl/dist/maplibre-gl.js,maplibre-gl/dist/maplibre-gl.css},api/pdf/_shared/capa-padrao.png}",
      "maxDuration": 60
    }
  }
}
